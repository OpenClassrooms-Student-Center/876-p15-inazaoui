{% extends 'admin.html.twig' %}

{% block admin %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3">Ajouter un média</h1>
        <a href="{{ path('admin_media_index') }}" class="btn btn-outline-primary">
            Retour
        </a>
    </div>

    {{ form_start(form) }}

    {# Champs admin uniquement #}
    {% if is_granted('ROLE_ADMIN') %}
        {{ form_row(form.user) }}
        {{ form_row(form.album) }}
    {% endif %}

    {{ form_row(form.title) }}
    {{ form_row(form.description) }}
    {{ form_row(form.file) }}

    <button type="submit" class="btn btn-primary mt-3">
        Ajouter
    </button>

    {{ form_end(form) }}
{% endblock %}
